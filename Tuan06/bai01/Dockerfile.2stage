# Stage 1: build/test
FROM node:20-alpine AS builder
WORKDIR /app
COPY app/package.json ./package.json
RUN npm install
COPY app/. ./
RUN npm test
RUN npm prune --omit=dev

# Stage 2: runtime
FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server.js ./server.js
EXPOSE 8080
CMD ["node", "server.js"]
